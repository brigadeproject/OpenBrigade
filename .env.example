# Copy to .env and replace placeholder values before starting the stack.

BRIGADE_BIND_ADDRESS=127.0.0.1
BRIGADE_STALE_WORK_SECONDS=86400
# Tool-call budget per agent dispatch cycle (also live-editable in the GUI).
BRIGADE_MAX_AGENT_ITERATIONS=10

BRIGADE_POSTGRES_DB=brigade
BRIGADE_POSTGRES_USER=brigade
BRIGADE_POSTGRES_PASSWORD=change-me
BRIGADE_POSTGRES_PORT=55432

BRIGADE_REDIS_PORT=56379

BRIGADE_QDRANT_HTTP_PORT=56333
BRIGADE_QDRANT_GRPC_PORT=56334
BRIGADE_QDRANT_COLLECTION=brigade_episodes_nomic_embed_text
BRIGADE_QDRANT_CHUNK_COLLECTION=brigade_chunks_nomic_embed_text

BRIGADE_NEO4J_AUTH=neo4j/change-me
BRIGADE_NEO4J_HTTP_PORT=57474
BRIGADE_NEO4J_BOLT_PORT=57687
BRIGADE_NEO4J_HEAP_INITIAL=512m
BRIGADE_NEO4J_HEAP_MAX=1G

BRIGADE_JWT_SECRET=replace-with-a-long-random-secret
BRIGADE_JWT_ISSUER=openbrigade-local
BRIGADE_JWT_AUDIENCE=openbrigade
BRIGADE_REQUIRE_AUTH=false
BRIGADE_WEB_PORT=58080

BRIGADE_OLLAMA_BASE_URL=http://host.docker.internal:11434
BRIGADE_DEFAULT_PROVIDER=ollama
BRIGADE_DEFAULT_MODEL=gpt-oss:20b
# If your embedding Ollama instance runs on a different port (e.g. a dedicated
# GPU), set BRIGADE_OLLAMA_EMBEDDING_BASE_URL to that address independently of
# BRIGADE_OLLAMA_BASE_URL.  Both default to port 11434 if unset.
BRIGADE_OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
BRIGADE_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
BRIGADE_OLLAMA_EMBEDDING_VECTOR_SIZE=768
BRIGADE_OLLAMA_PROXY_LISTEN_HOST=172.17.0.1
BRIGADE_OLLAMA_PROXY_PORT=11434
BRIGADE_OLLAMA_PROXY_TARGET_HOST=127.0.0.1
BRIGADE_OLLAMA_PROXY_TARGET_PORT=11434
# Chief-chat runs a multi-turn tool loop, so its prompts grow ~1-2KB per
# iteration (history + notes + observations). Give Ollama a real context
# window or long turns silently degrade to empty replies. 16384 is the
# built-in default; raise it if you run many iterations or a large history.
BRIGADE_OLLAMA_NUM_CTX=16384

# Chief chat (release 1.1): converse with per-team Crew Chiefs or the
# fleet-wide front desk in natural language. Enabled for the web/mobile UI by
# default; routing external connectors (Telegram, Google Chat) through it is a
# separate opt-in while it soaks.
BRIGADE_CHIEF_CHAT_ENABLED=true
BRIGADE_CHIEF_CHAT_MAX_ITERATIONS=6
BRIGADE_CHIEF_CHAT_HISTORY_WINDOW=12
# auto: a single-chief fleet talks to that chief, otherwise the front desk.
BRIGADE_CHIEF_CHAT_DEFAULT_PERSONA=auto
# Chiefs can fetch small HTTP(S) text responses mid-conversation (same
# web_fetch tool assignment agents already have). Disable to keep chat
# turns fully offline.
BRIGADE_CHIEF_CHAT_WEB_FETCH_ENABLED=true
BRIGADE_CONNECTOR_CHIEF_CHAT_ENABLED=false
BRIGADE_CHIEF_CHAT_CONNECTOR_MAX_ITERATIONS=3
BRIGADE_EXECUTIVE_ENABLED=true
BRIGADE_EXECUTIVE_MAX_ITERATIONS=6
BRIGADE_EXECUTIVE_WEB_FETCH_ENABLED=true
BRIGADE_CONNECTOR_EXECUTIVE_CHAT_ENABLED=false

# External connectors are disabled by default. Telegram polling is the
# recommended local ingress: it needs no public HTTP listener. Choose either
# polling or webhook mode, never both; see docs/CONNECTORS_RUNBOOK.md.
BRIGADE_TELEGRAM_WEBHOOK_ENABLED=false
# BRIGADE_TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# BRIGADE_TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
BRIGADE_TELEGRAM_POLLING_ENABLED=false
BRIGADE_TELEGRAM_POLLING_TIMEOUT_SECONDS=30
BRIGADE_TELEGRAM_ACCOUNT_REFRESH_SECONDS=10
BRIGADE_TELEGRAM_DEFAULT_AGENT=sage
# Optional comma-separated Telegram numeric user IDs. Leaving it empty sends
# new users through the durable pending-approval flow.
# BRIGADE_TELEGRAM_ALLOWLIST=123456789
# Optional recipient for orchestrator alerts sent through the same bot.
# BRIGADE_OPERATOR_TELEGRAM_CHAT_ID=123456789

# Optional owner-only direct Crew Chief chat. It remains disabled per Chief
# until an admin saves an explicit policy through the UI, API, or CLI.
BRIGADE_CHIEF_DIRECT_MAX_TOOL_CALLS=60
BRIGADE_CHIEF_DIRECT_MAX_ELAPSED_SECONDS=1800
BRIGADE_CHIEF_DIRECT_HARD_ELAPSED_SECONDS=7200
BRIGADE_CHIEF_DIRECT_CONTEXT_MAX_CHARS=32000
# Root-owned JSON file containing named exact-argv maintenance actions.
# BRIGADE_MAINTENANCE_ACTIONS_PATH=/data/maintenance-actions.json

# Google Chat is also disabled by default.
BRIGADE_GOOGLE_CHAT_WEBHOOK_ENABLED=false
# BRIGADE_GOOGLE_CHAT_SECRET=replace-with-a-long-random-secret
BRIGADE_GOOGLE_CHAT_DEFAULT_AGENT=sage
# BRIGADE_GOOGLE_CHAT_ALLOWLIST=example-external-user

# Connector safety limits. These values are forwarded into brigade_web by
# docker-compose.yml.
BRIGADE_CONNECTOR_RATE_LIMIT_COUNT=20
BRIGADE_CONNECTOR_RATE_LIMIT_WINDOW_SECONDS=60
BRIGADE_CONNECTOR_MAX_BODY_BYTES=1048576
BRIGADE_CONNECTOR_MAX_INBOUND_CHARS=4000
BRIGADE_CONNECTOR_MAX_OUTBOUND_CHARS=3500

# Research tools. The app profile runs SearXNG and an isolated Playwright
# browser worker internally; no host ports are published for either service.
BRIGADE_SEARCH_BACKEND=searxng
BRIGADE_SEARXNG_URL=http://brigade_searxng:8080
# Comma-separated SearXNG engines permitted for research. `google cse` is the bundled deployment's verified ID.
BRIGADE_SEARCH_ALLOWED_ENGINES=google cse
BRIGADE_BROWSER_WORKER_URL=http://brigade_browser:8765
# Optional JSON file mounted in BRIGADE_DATA_DIR. Shape:
# {"servers":[{"name":"filesystem","transport":"stdio","command":["..."]}]}
BRIGADE_MCP_CONFIG=/data/mcp_servers.json
# Optional absolute local or NAS mount used for retained fetched research sources.
# BRIGADE_RESEARCH_STORAGE_PATH=/mnt/openbrigade-research

# To route orchestration and agent defaults through OpenAI/Codex instead of Ollama:
# OPENAI_API_KEY=replace-with-openai-api-key
# BRIGADE_DEFAULT_PROVIDER=openai-codex
# BRIGADE_DEFAULT_MODEL=gpt-5.4
# BRIGADE_OPENAI_CODEX_AUTH_MODE=api_key
#
# OAuth/manual-token route for OpenAI/Codex:
# BRIGADE_DEFAULT_PROVIDER=openai-codex
# BRIGADE_DEFAULT_MODEL=gpt-5.4
# BRIGADE_OPENAI_CODEX_AUTH_MODE=oauth
# Then import a token locally with:
#   ./ops/brigade-live.sh model auth login --provider openai-codex --method oauth --access-token-stdin
#
# Existing agents keep their persisted route until updated:
#   ./ops/brigade-live.sh agent model --id <agent-id> --provider openai-codex --model gpt-5.4
