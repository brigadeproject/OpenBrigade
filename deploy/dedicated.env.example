# Copy to /opt/openbrigade/.env for host-native OpenBrigade services.
# Keep this file root:brigade mode 0640; never commit a populated .env.
BRIGADE_DATA_DIR=/srv/openbrigade/app
BRIGADE_SUPPORT_BIND_ADDRESS=127.0.0.1
BRIGADE_BIND_ADDRESS=127.0.0.1
BRIGADE_WEB_PORT=58080
BRIGADE_REQUIRE_AUTH=true
BRIGADE_POSTGRES_DSN=postgresql://brigade:replace-me@127.0.0.1:55432/brigade
BRIGADE_REDIS_URL=redis://127.0.0.1:56379/0
BRIGADE_QDRANT_URL=http://127.0.0.1:56333
BRIGADE_NEO4J_URI=bolt://127.0.0.1:57687
BRIGADE_NEO4J_HTTP_URL=http://127.0.0.1:57474
BRIGADE_NEO4J_AUTH=neo4j/replace-me
BRIGADE_SEARXNG_URL=http://127.0.0.1:58888
BRIGADE_BROWSER_WORKER_URL=http://127.0.0.1:58765
BRIGADE_OLLAMA_BASE_URL=http://inference-host:11434
BRIGADE_OLLAMA_EMBEDDING_BASE_URL=http://inference-host:11435
BRIGADE_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
BRIGADE_OLLAMA_EMBEDDING_VECTOR_SIZE=768
BRIGADE_DEFAULT_PROVIDER=ollama
BRIGADE_DEFAULT_MODEL=gpt-oss:20b
BRIGADE_JWT_SECRET=replace-with-a-long-random-secret
BRIGADE_POSTGRES_PASSWORD=replace-me
